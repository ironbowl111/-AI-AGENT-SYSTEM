  "techniques": [
    {
      "id": "tech_001",
      "name": "把持・配置の感覚統合技法",
      "purpose": "視覚・力覚・把持位置の三要素を統合した高精度物体操作法。前上角または側面への軽圧把持、3割程度の最適握力、視線の先読み（次工程）または重心同期、および隙間均一性とトルク安定性のクロスバリデーションにより、安定性・遷移性・即時判断力を向上させる。",
      "steps": [
        "把持時は上面と前面の交わる前上角、あるいは側面を親指と人差し指で軽く押さえる（30〜40%握力）。視線は次に配置する対象や物理的重心に固定し、動作連続性・姿勢安定・回転防止を実現。配置判断では、視覚的に左右隙間の均一性を確認すると同時に、手元の振動・抵抗感として感知されるトルクの静的安定を「正しく載った」判定基準とし、単一感覚に依存しないクロスバリデーションを採用。"
      ],
      "failure_modes": [],
      "success_indicators": [],
      "source": "expert_dialogue"
    }
  ],
