{
  "document": {
    "id": "SOP-PC-REFURB-001",
    "task_name": "ノートPC 分解・組み立て・動作確認",
    "version": "1.0",
    "source": "NSSOL 簡易手順書",
    "note": "計20項目。記述は目標・下位目標のレベルであり、操作レベルの手順は含まない"
  },
  "phases": [
    { "id": "P1", "name": "分解" },
    { "id": "P2", "name": "組み立て" },
    { "id": "P3", "name": "動作確認" }
  ],
  "items": [
    { "id": "P1.S1", "phase": "P1", "text": "電源を抜き、電源が切れていることを確認" },
    { "id": "P1.S2", "phase": "P1", "text": "裏蓋のねじを外す" },
    { "id": "P1.S3", "phase": "P1", "text": "裏蓋を外す" },
    { "id": "P1.S4", "phase": "P1", "text": "SSDカバーのねじを外し、カバーを取り外す" },
    { "id": "P1.S5", "phase": "P1", "text": "SSDを取り外す" },

    { "id": "P2.S1", "phase": "P2", "text": "SSDを取り付ける" },
    { "id": "P2.S2", "phase": "P2", "text": "SSDカバーを取り付け、ねじを締める" },
    { "id": "P2.S3", "phase": "P2", "text": "裏蓋をつける" },
    { "id": "P2.S4", "phase": "P2", "text": "裏蓋のねじを閉める" },
    { "id": "P2.S5", "phase": "P2", "text": "目立った汚れ、すれ、傷がないか、コネクタの破損がないか確認" },

    { "id": "P3.S1", "phase": "P3", "text": "PCを起動" },
    { "id": "P3.S2", "phase": "P3", "text": "Win+Shift+S を押し、録画ツールを起動し、録画する" },
    { "id": "P3.S3", "phase": "P3", "text": "設定画面を開き、タッチパッドの動作を確認（1本指で動くこと、2本指でスクロールできること）" },
    { "id": "P3.S4", "phase": "P3", "text": "タスクマネージャを開き、CPUとSSDの型番とSSDの容量を確認し、メモする" },
    { "id": "P3.S5", "phase": "P3", "text": "設定画面からOSのバージョンを確認し、メモする" },
    { "id": "P3.S6", "phase": "P3", "text": "メモ帳を開き、一つずつキーを押し、確認（英数字キーのみを対象とする）" },
    { "id": "P3.S7", "phase": "P3", "text": "カメラアプリを確認し、カメラの色が異常ではないことを確認" },
    { "id": "P3.S8", "phase": "P3", "text": "スピーカの音量を最大にし、設定画面から音声テストを実施" },
    { "id": "P3.S9", "phase": "P3", "text": "設定画面からマイクのテストを実施" },
    { "id": "P3.S10", "phase": "P3", "text": "録画を停止" }
  ]
}
